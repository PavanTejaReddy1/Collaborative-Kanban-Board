{
  "name": "collaborative-kanban-server",
  "version": "1.0.0",
  "description": "Express + MongoDB backend for the Collaborative Kanban Board",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "seed": "node src/seed.js",
    "seed:fresh": "node src/seed.js --fresh",
    "test": "npx vitest run --config vitest.config.js",
    "test:watch": "npx vitest --config vitest.config.js",
    "test:coverage": "npx vitest run --config vitest.config.js --coverage"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.21.1",
    "express-rate-limit": "7.4.1",
    "helmet": "8.0.0",
    "joi": "17.13.3",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.7.3",
    "morgan": "1.10.0",
    "socket.io": "4.7.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "2.1.4",
    "nodemon": "3.1.7",
    "supertest": "7.0.0",
    "vitest": "2.1.4"
  },
  "vitest": {
    "environment": "node",
    "globals": true,
    "testMatch": ["**/__tests__/**/*.test.js"],
    "hookTimeout": 30000,
    "testTimeout": 30000,
    "coverage": {
      "provider": "v8",
      "reporter": ["text", "json", "html"]
    }
  }
}
