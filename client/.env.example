# ─── Frontend Environment Variables ────────────────────────────────────────
# Copy this file to .env.local in Vercel dashboard or .env locally.

# ── Local development ────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# ── Both deployed on Vercel ──────────────────────────────────────────────────
# Replace YOUR_BACKEND_PROJECT with your actual Vercel backend project name
# VITE_API_BASE_URL=https://YOUR_BACKEND_PROJECT.vercel.app/api
# VITE_SOCKET_URL=https://YOUR_BACKEND_PROJECT.vercel.app
